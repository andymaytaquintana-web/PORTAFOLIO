tabla <- matrix(
c(
8, 10, 2,    # Ventas
4, 11, 5,    # Marketing
10, 7, 3     # Finanzas
),
nrow = 3,
byrow = TRUE
)
rownames(tabla) <- c(
"Ventas",
"Marketing",
"Finanzas"
)
colnames(tabla) <- c(
"Presencial",
"Hibrida",
"Remota"
)
tabla
resultado <- fisher.test(
tabla,
simulate.p.value = TRUE,
B = 99999
)
resultado
