# EJERCICIO 7 - PRUEBA DE INDEPENDENCIA

# prueba de independencia

olivos <- subset(caso1, Distrito == "Los Olivos")
table(olivos$Antigüedad, olivos$Uso1)
chisq.test(olivos$Antigüedad, olivos$Uso1, correct = T)

# indicadores
a1 <- factor(olivos$Antigüedad,
                levels = c("Mas de 30 años",
                           "Entre 10 y 20 años",
                           "Menos de 10 años"),
                ordered = TRUE)

a2 <- factor(olivos$Uso1, levels = c("bajo","medio","alto"),
             ordered = TRUE)
a1 <- as.numeric(a1)
a2 <- as.numeric(a2)
cor.test(a1,a2, method = "s", alternative = "g")
cor.test(a1, a2, method = "k", alternative = "g")


'''
H0:  la antigüedad de la vivienda y el consumo mensual de electricidad en el
    mes de enero son independientes (no relacionadas)
H1:  la antigüedad de la vivienda y el consumo mensual de electricidad en el 
    mes de enero no son independientes (si relacionadas)

alfa = 0.03
pvalor = 0.3812 > 0.03
Conclusión: A un alfa = 0.03, No podemos afirmar que la antigüedad de la 
vivienda y el consumo mensual de electricidad en el mes de enero esten
relacionadas.
'''


