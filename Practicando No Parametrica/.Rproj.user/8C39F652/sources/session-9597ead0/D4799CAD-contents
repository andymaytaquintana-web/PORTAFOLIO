pc1 <- read_xlsx("PC1.xlsx")

# EJERCICIO 1 - CORRELACION DE SPEARMAN

sur <- subset(pc1, sede == "Sur")
s1 <- factor(sur$satisfacción1, levels = c("Muy insatisfecho",
                                           "Insatisfecho",
                                           "Neutral",
                                           "Satisfecho",
                                           "Muy satisfecho"), ordered = TRUE)
s2 <- factor(sur$satisfacción2, levels = c("Muy insatisfecho",
                                           "Insatisfecho",
                                           "Neutral",
                                           "Satisfecho",
                                           "Muy satisfecho"), ordered = TRUE)

s1 <- as.numeric(s1)
s2 <- as.numeric(s2)

cor.test(s1, s2, method = "s",
         alternative = "g")


