# EJERCICIO 4 - MEDIDA DE ASOCIACION SPEARMAN

masc <- subset(antes, Género == "Masculino")
table(masc$Estrés, masc$Sueño)
d1 <- factor(masc$Estrés, levels = c("Bajo","Medio","Alto"), ordered = T)
d2 <- factor(masc$Sueño, levels = c("Mala","Regular","Buena"), ordered = T)

d1 <- as.numeric(d1)
d2 <- as.numeric(d2)
cor.test(d1, d2, method = "s", alternative = "l")


'''
H0: rho = 0
H1: rho < 0
alfa = 0.04
pvalor = 0.6911 > 0.04
Conclusión: A un alfa = 0.04, No podemos afirmar que a mayor nivel de estres
menor sea la calidad de sueño para los desarrolladores de software del genero
masculino, por lo tanto no se contratará a un psicologo.
'''

